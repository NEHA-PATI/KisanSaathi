# Backend Environment Variables Template
# Copy this to backend/.env and fill in with actual values

# ==== DATABASE CONFIGURATION ====
# For OCI Docker deployment, DB_HOST should be db.
DB_HOST=db
DB_PORT=5432
DB_NAME=bhoomidb
DB_USER=bhoomi
DB_PASSWORD=your_secure_password_here

# ==== FRONTEND CONFIGURATION ====
# Your domain or frontend Render URL
FRONTEND_URL=https://maatitrace.in

# ==== BACKEND CONFIGURATION ====
BACKEND_URL=https://api.maatitrace.in

# ==== ENVIRONMENT ====
ENVIRONMENT=production

# Optional fallback district for old CSV fallback paths and default behavior.
# The live PostGIS app loads and queries all districts listed in backend/ingestion/district_config.json.
BHOOMI_DISTRICT=sambalpur

# ==== LOGGING (Optional) ====
LOG_LEVEL=INFO
