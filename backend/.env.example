# Backend Environment Variables Template
# Copy this to backend/.env for local development, or set these in your host.

# ==== DATABASE CONFIGURATION ====
# Local dev: DB_HOST=localhost
# Docker/OCI compose: DB_HOST=db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=BhoomiAI
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Production can use either DATABASE_URL or the DB_* variables above.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/database

# ==== FRONTEND / CORS CONFIGURATION ====
# Comma-separated frontend origins allowed to call the backend.
FRONTEND_URLS=http://localhost:5173,https://maatitrace.in,https://www.maatitrace.in

# ==== BACKEND CONFIGURATION ====
BACKEND_URL=https://api.maatitrace.in
ENVIRONMENT=production

# Optional fallback district for old CSV fallback paths and default behavior.
# The live PostGIS app loads and queries all districts listed in backend/ingestion/district_config.json.
BHOOMI_DISTRICT=sambalpur

# ==== LOGGING (Optional) ====
LOG_LEVEL=INFO
